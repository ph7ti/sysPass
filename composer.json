{
  "name": "syspass/syspass",
  "description": "PHP web based Password Manager for business and personal use.",
  "homepage": "https://syspass.org",
  "minimum-stability": "stable",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Rubén Domínguez",
      "email": "nuxsmin@syspass.org",
      "role": "Author/Developer",
      "homepage": "https://syspass.org/"
    }
  ],
  "support": {
    "issues": "https://github.com/nuxsmin/sysPass/issues",
    "source": "https://github.com/nuxsmin/sysPass",
    "docs": "https://doc.syspass.org"
  },
  "require": {
    "php": "^8.2",
    "defuse/php-encryption": "^2.4",
    "phpmailer/phpmailer": "^6.9",
    "phpseclib/phpseclib": "^3.0.57",
    "klein/klein": "^2.1.2",
    "php-di/php-di": "^7.0",
    "guzzlehttp/guzzle": "^7.8",
    "monolog/monolog": "^3.7",
    "symfony/error-handler": "^6.4",
    "ext-pdo": "*",
    "ext-dom": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-gettext": "*",
    "ext-fileinfo": "*",
    "ext-zlib": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^9.6",
    "fakerphp/faker": "^1.23",
    "symfony/browser-kit": "^6.4",
    "symfony/http-client": "^6.4",
    "syspass/extension-installer-plugin": "v2.0.0",
    "nikic/php-parser": "^4.19",
    "php-mock/php-mock-phpunit": "^2.9"
  },
  "suggest": {
    "syspass/plugin-authenticator": "^v2.2",
    "ext-ldap": "*",
    "ext-curl": "*",
    "ext-xdebug": "*"
  },
  "autoload": {
    "psr-4": {
      "SP\\": "lib/SP/",
      "SP\\Modules\\Web\\": "app/modules/web/",
      "SP\\Modules\\Api\\": "app/modules/api/",
      "SP\\Tests\\": "tests/SP/"
    }
  },
  "config": {
    "classmap-authoritative": false,
    "allow-plugins": {
      "syspass/extension-installer-plugin": true
    },
    "platform": {
      "php": "8.2.0"
    }
  }
}
